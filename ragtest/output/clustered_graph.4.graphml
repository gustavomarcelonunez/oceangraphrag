    <edge source="POBLACI&#211;N" target="LOBER&#205;A &#8220;ISLA CUMBRE&#8221;">
      <data key="d8">7.0</data>
      <data key="d9">La lobera &#8220;Isla Cumbre&#8221; tiene una poblaci&#243;n de lobos que se mide en t&#233;rminos de individuos.</data>
      <data key="d10">1c009b787d8ca6f50004733e3e2ff5fd</data>
