      <data key="d8">7.0</data>
      <data key="d9">El arreo es un m&#233;todo utilizado para guiar a los lobos marinos hacia su captura</data>
      <data key="d10">1cdd9979abf4b18739d1ecc67ef55fdf</data>
      <data key="d11">7d49a4724a324b21af7440a73cb5bfab</data>
      <data key="d12">63</data>
