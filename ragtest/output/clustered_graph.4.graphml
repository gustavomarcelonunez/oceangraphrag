    <node id="ISLA YUNQUE">
      <data key="d0">PINNIPED</data>
      <data key="d1">La lobera "Isla Yunque" es un islote con vegetaci&#243;n, ubicado en el Canal de Beagle, caracterizado por su playa estrecha y rocosa.</data>
