    <node id="PUNTA DELGADA">
      <data key="d0">HABITAT</data>
      <data key="d1">Punta Delgada es un &#225;rea de explotaci&#243;n en la Pen&#237;nsula Vald&#233;s, Argentina, donde se realizan actividades de caza de lobos marinos.</data>
