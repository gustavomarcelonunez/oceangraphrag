    <node id="ISLOTE INNOMINADO">
      <data key="d0">HABITAT</data>
      <data key="d1">El islote Innominado es un h&#225;bitat marino que alberga una poblaci&#243;n de lobos marinos, siendo parte de la poblaci&#243;n lobera que se reproduce en la regi&#243;n.</data>
      <data key="d2">8094ad56e19f2d8b0932bb2286f2ed53</data>
