      <data key="d7">1c2e1559a78b4c97963481701dc303b5</data>
    </node>
    <node id="POLICARPO OESTE">
      <data key="d0">HABITAT</data>
      <data key="d1">Policarpo Oeste es una lober&#237;a en Tierra del Fuego, conocida por ser la m&#225;s poblada de lobos marinos de un pelo.</data>
      <data key="d2">87a7088ac4002732ed52061ec147e2d3</data>
