    <edge source="LOBOS MARINOS" target="CABO BUEN SUCESO">
      <data key="d8">6.0</data>
      <data key="d9">Cabo Buen Suceso es un punto geogr&#225;fico relevante para la navegaci&#243;n y la explotaci&#243;n de lobos marinos</data>
