    <node id="HOMBRES">
      <data key="d0">MAMMAL</data>
      <data key="d1">Los hombres son machos de la especie de lobos marinos, que se encuentran en las lober&#237;as y participan en la reproducci&#243;n.</data>
      <data key="d2">b51dc25f877bd2b2e62ff7caf9ce3cc8</data>
