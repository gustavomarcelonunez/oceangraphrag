    <edge source="ISLOTE CABO" target="BANCO CORMOR&#193;N">
      <data key="d8">5.0</data>
      <data key="d9">Ambos son &#225;reas en la regi&#243;n de Santa Cruz, con recursos guaneros en estado de explotaci&#243;n o formaci&#243;n.</data>
      <data key="d10">6507ca3cc204e34dfdf51de0a0137bb5</data>
      <data key="d11">1f97a57d5649432ea485e2d132090caf</data>
      <data key="d12">529</data>
