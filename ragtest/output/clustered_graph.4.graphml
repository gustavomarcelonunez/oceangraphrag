    </node>
    <node id="PLAYA ESTRECHA">
      <data key="d0">HABITAT</data>
      <data key="d1">Una playa estrecha es una franja de arena y rocas que sirve como h&#225;bitat para lobos marinos, donde pueden descansar y socializar.</data>
      <data key="d2">c9dce606e4689259e6ae53f4c2d3cf41</data>
