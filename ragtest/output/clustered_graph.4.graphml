    </node>
    <node id="PUNTA PIR&#193;MIDES">
      <data key="d0">HABITAT</data>
      <data key="d1">Punta Pir&#225;mides es una colonia de lobos marinos en la Pen&#237;nsula Vald&#233;s, cerca del puerto hom&#243;nimo, con una poblaci&#243;n significativa.</data>
      <data key="d2">87a7088ac4002732ed52061ec147e2d3</data>
