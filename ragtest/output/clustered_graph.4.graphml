    <node id="HOMBRE">
      <data key="d0">MAMMAL</data>
      <data key="d1">El hombre es un mam&#237;fero que interact&#250;a con los lobos marinos, a menudo involucr&#225;ndose en actividades de explotaci&#243;n y conservaci&#243;n.</data>
      <data key="d2">b8fc1429909e4ec64034d88ce09e488c</data>
