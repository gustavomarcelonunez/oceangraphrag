    <node id="LOBER&#205;AS PUNTA PIR&#193;MIDES">
      <data key="d0">NONE</data>
      <data key="d1">Las lober&#237;as Punta Pir&#225;mides son zonas de reproducci&#243;n de lobos marinos, situadas al N.E. del Golfo Nuevo, con costas rocosas y caracter&#237;sticas de parici&#243;n.</data>
      <data key="d2">e15301b6f26ca285ce93457a5f2a3287</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
