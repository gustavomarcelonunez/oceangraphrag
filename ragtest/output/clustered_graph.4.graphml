    <edge source="LOBOS MARINOS DE UN PELO" target="DESPLAZAMIENTOS">
      <data key="d8">7.0</data>
      <data key="d9">Los desplazamientos son parte del comportamiento migratorio de los lobos marinos de un pelo.</data>
