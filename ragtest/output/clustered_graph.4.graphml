      <data key="d7">cb56c91c9c4e4cdcac067e4fcc0294ce</data>
    </node>
    <node id="ISLOTE NOROESTE DE PUNTA LOBER&#205;A">
      <data key="d0">HABITAT</data>
      <data key="d1">El islote noroeste de Punta Lober&#237;a es un h&#225;bitat marino que alberga una poblaci&#243;n de lobos marinos, caracterizado por su topograf&#237;a rocosa y escasa elevaci&#243;n.</data>
      <data key="d2">8094ad56e19f2d8b0932bb2286f2ed53</data>
