      <data key="d4">2</data>
      <data key="d5">6</data>
      <data key="d6">190</data>
      <data key="d7">a8bf3e2d8c914458898859288c96cbf1</data>
    </node>
    <node id="CARACTER&#205;STICAS DE PARICI&#211;N">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las caracter&#237;sticas de parici&#243;n se refieren a los aspectos reproductivos de los lobos marinos, incluyendo el tiempo y las condiciones en que dan a luz a sus cr&#237;as.</data>
      <data key="d2">8094ad56e19f2d8b0932bb2286f2ed53</data>
