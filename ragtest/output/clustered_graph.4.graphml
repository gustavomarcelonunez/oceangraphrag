    <node id="ISLA BLANCA ESTE">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Blanca Este es un islote rocoso, de escasa altura, que sirve como h&#225;bitat para una poblaci&#243;n de lobos marinos, visible desde la costa.</data>
