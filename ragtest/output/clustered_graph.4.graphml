    <node id="MUJERES">
      <data key="d0">MAMMAL</data>
      <data key="d1">Las mujeres son hembras de la especie de lobos marinos, que son responsables del cuidado de las cr&#237;as en las lober&#237;as.</data>
      <data key="d2">b51dc25f877bd2b2e62ff7caf9ce3cc8</data>
