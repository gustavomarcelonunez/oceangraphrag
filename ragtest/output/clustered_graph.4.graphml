    <node id="ISLA GEORGIA DEL SUR">
      <data key="d0">HABITAT</data>
      <data key="d1">Isla Georgia del Sur es un &#225;rea de explotaci&#243;n donde se cazan elefantes marinos, conocida por su ecosistema marino &#250;nico.</data>
      <data key="d2">c5da7903f39c55be6946c60a6500b053</data>
