    <node id="BARRANCAS">
      <data key="d0">HABITAT</data>
      <data key="d1">Las barrancas son formaciones geol&#243;gicas que se encuentran en las costas, que pueden servir como h&#225;bitat para especies como lobos marinos y aves marinas.</data>
      <data key="d2">f1c4f1e9ce741c6722e1f6e66b00f198</data>
