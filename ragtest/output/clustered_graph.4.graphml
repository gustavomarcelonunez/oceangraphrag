    </node>
    <node id="ISLAS HERMANOS">
      <data key="d0">HABITAT</data>
      <data key="d1">Los islotes Hermanos son peque&#241;as islas en el Canal de Beagle que sirven como h&#225;bitat temporal para lobos marinos, donde se agrupan para descansar y reproducirse.</data>
      <data key="d2">c9dce606e4689259e6ae53f4c2d3cf41</data>
