    </node>
    <node id="LOBER&#205;AS PUNTA NINFAS">
      <data key="d0">NONE</data>
      <data key="d1">Las lober&#237;as Punta Ninfas son lugares de agrupamiento de lobos marinos, localizadas en la costa W. SW. de Punta Ninfas, con barrancas altas y vegetaci&#243;n t&#237;pica.</data>
      <data key="d2">e15301b6f26ca285ce93457a5f2a3287</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
      <data key="d5">6</data>
