    <node id="PARRICI&#211;N">
      <data key="d0">REPRODUCTION</data>
      <data key="d1">La parici&#243;n es el proceso de dar a luz en los lobos marinos, que ocurre en las loberas durante ciertas &#233;pocas del a&#241;o.</data>
      <data key="d2">b8fc1429909e4ec64034d88ce09e488c</data>
