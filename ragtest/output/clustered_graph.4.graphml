      <data key="d8">7.0</data>
      <data key="d9">Bah&#237;a Buen Suceso es un &#225;rea donde se pueden encontrar lobos marinos y se realizan actividades de explotaci&#243;n</data>
      <data key="d10">50b35b2bc089e6bdea6e0bc77c7ab025</data>
