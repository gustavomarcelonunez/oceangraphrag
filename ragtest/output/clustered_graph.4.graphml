    <node id="L">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">L se refiere a la cantidad de lobos marinos en una lober&#237;a, que incluye tanto machos como hembras y cr&#237;as.</data>
