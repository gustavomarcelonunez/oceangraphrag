    </node>
    <node id="LOBERO">
      <data key="d0">NONE</data>
      <data key="d1">Los lobos marinos son un grupo de mam&#237;feros marinos que incluye focas, leones marinos y morsas, conocidos por su adaptaci&#243;n a la vida en el agua y en tierra.)("entity"</data>
      <data key="d2">882fdf01528bf45b0f6d55ba9924f551</data>
