    <node id="OTARIA FLAVESCENS">
      <data key="d0">SPECIES</data>
      <data key="d1">Otaria flavescens es una especie de lobo marino que habita en las costas de Am&#233;rica del Sur, caracterizada por su pelaje y su comportamiento social.</data>
      <data key="d2">03319985b4a7a0e66f98389e459009f7,08e9f4bcb8bee78292601780a46936c6,103d13f2a7d5f4c20fac4a64966b8fde,144ccee104076cb699414480fca2f46b,2d041f866c2a7f149216961d43696c82,4637827f6813c74937485d62b3f596b8,583f551deb29bf66f80bcf97f89e3c64,59a2e76fa5cfb51e15d733d19084f125,5a07380f5aada9c6c6ef41f242e1c536,773258f4983ae1adc2e995e6a7bd7aa6,77e645beba0bf5256ed258f3fdd4a25e,8a0c5d2be39b9a9e02f97cbc7551030c,929b52dcc39f3e79e12fe7e15557dbaf,9d8e3504b4ee32dcb2cfe65980dddcaa,a7319504eeb762ae0cc5b15c4d6b5461,abfbf0cbd4646b7d6aff58787b3de0bd,acce0f2d52d35b868047d606555fc1e4,b58cdc05bb2d9dbcf563d7eaa562cf0f,bcde333e96de3a3e79ca9adcfa798014,c189d2e78df197f5464424712ff00b40,cd89fd819728e8bb01132a958eb61182,cf58f0416a8d27360f6d6e772471b831,ff2c7455e99e69b4239b601fef6b447e</data>
