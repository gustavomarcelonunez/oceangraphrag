    <node id="LOBOS MARINOS DE UN PELO">
      <data key="d0">PINNIPED</data>
      <data key="d1">Los lobos marinos de uno y dos pelos son especies de pinn&#237;pedos que se encuentran en las costas atl&#225;nticas y fueguinas, conocidos por su comportamiento social y su h&#225;bitat en colonias.</data>
      <data key="d2">03319985b4a7a0e66f98389e459009f7</data>
      <data key="d3">0</data>
